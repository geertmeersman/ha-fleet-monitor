# SMTP configuratie
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HA Fleet Monitor <your@email.com>

# Test modus: stuurt alle mails naar SMTP_TEST_RECIPIENT i.p.v. het ingestelde emailadres
SMTP_TEST_MODE=false
SMTP_TEST_RECIPIENT=

# Admin CC: altijd in CC gezet op elke mail
SMTP_ADMIN_CC=
